---
import { getCollection } from "astro:content";
import { Desktop } from "../components/desktop/Desktop";
import type { WorkItem } from "../components/desktop/WorksList";
import "../styles/global.css";
import { SITE_DESCRIPTION } from "../consts";

// 作品データを取得してorderでソート
const worksEntries = await getCollection("works");
const works: WorkItem[] = worksEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    url: entry.data.url,
  }));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Desktop - Sol-momma</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- 
      PreactのDesktopコンポーネントをclient:loadで読み込む
      Why not: client:idleではなくclient:loadを使う理由は、デスクトップUIはページの中核機能なので即座にインタラクティブにすべきため
    -->
    <Desktop client:load works={works} />
  </body>
</html>
